+def distance_sigma(distance, row):
+    """
+    E(B-V) 不确定度，按距离分段取值，与 dustmaps3d 包 (core.read_map) 的规则一致：
+    d<1 kpc 取 min(sigma, sigma_0_2)；1–2 kpc 取 min(sigma, sigma_0_2, sigma_1_4)；
+    2–4 kpc 取 min(sigma_1_4, sigma_2_max)；≥4 kpc 取 sigma_2_max；后两段为 NaN 时退回 sigma。
+    数据缺少分段列时，相当于只用 sigma。
+    """
+    part = lambda name: row.get(name, np.nan)
+    with warnings.catch_warnings():
+        warnings.simplefilter("ignore", RuntimeWarning)  # 全为 NaN 时 nanmin 返回 NaN，与包一致
+        if distance < 1:
+            return np.nanmin([row['sigma'], part('sigma_0_2')])
+        if distance < 2:
+            return np.nanmin([row['sigma'], part('sigma_0_2'), part('sigma_1_4')])
+        primary = np.nanmin([part('sigma_1_4'), part('sigma_2_max')]) if distance < 4 else part('sigma_2_max')
+    return row['sigma'] if pd.isna(primary) else primary
+
