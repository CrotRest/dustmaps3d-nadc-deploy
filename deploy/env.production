# dustmaps3d-backend configuration for the NADC deployment.
# Copy to /opt/dustmaps3d/backend/.env (the service runs with that directory as its working directory).
# Relative paths below resolve from /opt/dustmaps3d/backend.

# Own SQLite database (created by `python -m dustmaps_backend.database init --seed`).
# The website only needs it for the backend's operation log; it does not store user data.
DUSTMAPS_DATABASE_URL=sqlite:///./var/dustmaps.db
DUSTMAPS_BCP_ARTICLE_IDS=["demo-bcp"]

# Generated PNGs; nginx forwards <prefix>/files/ here through the backend. Keep PUBLIC_BASE_URL
# empty: the backend then returns "/files/<name>.png" and the website turns that into a URL
# relative to its own page.
DUSTMAPS_OUTPUT_DIR=var/results
DUSTMAPS_PUBLIC_BASE_URL=

# Same origin behind nginx, so no CORS is needed.
DUSTMAPS_CORS_ORIGINS=[]

# Model data (step 4.4 of README.md).
DUSTMAPS_DUST_DATA_PATH=/opt/dustmaps3d/data/data.parquet
DUSTMAPS_DUSTMAPS_FITS_PATH=/opt/dustmaps3d/data/data_v3.fits

# Oblique slice (02, step 4.4b of README.md): 3D grid + superbubble table.
DUSTMAPS_DUST_3D_PATH=/opt/dustmaps3d/data/grid3d.parquet
DUSTMAPS_SUPERBUBBLE_PATH=/opt/dustmaps3d/data/superbubble_final_fit_parameters.csv

# Not used by this website (3-D viewer / CMS files): leave empty.
DUSTMAPS_FONT_PATH=
DUSTMAPS_VIEWER_DIR=
DUSTMAPS_CMS_FILES_DIR=

# STILTS launcher (step 4.5): one executable path, no arguments.
DUSTMAPS_STILTS_COMMAND=/opt/dustmaps3d/stilts/stilts

# Resource limits. Each computation worker holds ~2–3 GB of model data in memory;
# raise COMPUTE_WORKERS to 2 only with >= 16 GB RAM.
DUSTMAPS_COMPUTE_WORKERS=1
DUSTMAPS_MAX_PENDING_COMPUTATIONS=4
DUSTMAPS_COMPUTE_TIMEOUT_SECONDS=300
DUSTMAPS_MAX_UPLOAD_MB=20
DUSTMAPS_MAX_BATCH_ROWS=100000
